---
import Base from '../../layouts/Base.astro';
import EntryName from '../../components/EntryName.astro';
import Section from '../../components/Section.astro';
import { loadLexicon, entryUrl, buildUrl, traitUrl, href } from '../../lib/lexicon';
import { isLinked } from '../../lib/graph';
import { stationsOf } from '../../lib/stations';
import { traitsOf, neighboursOf } from '../../lib/traits';

export async function getStaticPaths() {
  const lex = await loadLexicon();
  return lex.entries.map((e, i) => ({
    params: { name: e.name },
    props: {
      name: e.name,
      prev: lex.entries[i - 1]?.name ?? null,
      next: lex.entries[i + 1]?.name ?? null,
    },
  }));
}

const lex = await loadLexicon();
const { name, prev, next } = Astro.props;
const e = lex.byName.get(name)!;
const family = lex.familyOf.get(e.name);

// The entry's signature, and the entries built from the same parts.
const traits = traitsOf(e.name);
const related = neighboursOf(e, lex.entries);
// An entry's own trait set is always a closed concept, so it is always a place
// in the lattice: this opens 組裝 already standing on this combination.
const spot = lex.lattice.byId.get(traits.map((t) => t.id).join('-'));

// Same seven stations for every entry. The ones this entry does not fill stay
// in the spine, greyed, so a gap reads as a gap rather than as an absence.
const stations = stationsOf(e);
const leads = new Map(stations.map((st) => [st.key, st.items.filter((p) => p.lead)]));
const quals = new Map(stations.map((st) => [st.key, st.items.filter((p) => !p.lead)]));
const num = (n: number) => String(n).padStart(2, '0');
---
<Base
  lex={lex}
  view="entries"
  title={`${e.name} — 抽象結構詞庫`}
  description={e.oneLine}
  current={e.name}
>
  <article class="entry">
    <header class="entry-head">
      <p class="eyebrow">{[family, e.status].filter(Boolean).join(' · ')}</p>
      <h2 class="entry-title"><EntryName name={e.name} /></h2>
      <p class="one-line">{e.oneLine}</p>

      <ul class="tr-sig" aria-label="這個詞條由哪些特徵組成">
        {traits.map((t) => (
          <li>
            <a class="tr" href={traitUrl(t.id)} title={t.plain}>
              <i>{t.id}</i>{t.name}
            </a>
          </li>
        ))}
        {spot && (
          <li>
            <a class="tr tr--go" href={buildUrl(spot.id)}>
              組裝<i>{spot.extent.length > 1 ? `同組還有 ${spot.extent.length - 1} 個` : '只有它'}</i>
            </a>
          </li>
        )}
      </ul>

      <nav class="spine" aria-label="這個詞條的段落">
        {stations.map((st) =>
          st.present ? (
            <a class="sp" href={`#${st.key}`}><i>{num(st.n)}</i>{st.name}</a>
          ) : (
            <span class="sp is-gap" title="這個詞條還沒有這一段">{st.name}</span>
          )
        )}
      </nav>
    </header>

    {stations.filter((st) => st.present).map((st) => (
      <section class:list={['stn', `stn--${st.key}`]} id={st.key}>
        <header class="stn-head">
          <span class="stn-n">{num(st.n)}</span>
          <h3 class="stn-name">{st.name}</h3>
          <p class="stn-hint">{st.hint}</p>
        </header>

        {leads.get(st.key)!.map((p) => <Section section={p.section} />)}

        {/* One qualifier is not parallel to anything, so it stays full width. */}
        {quals.get(st.key)!.length === 1 ? (
          <Section section={quals.get(st.key)![0].section} compact />
        ) : quals.get(st.key)!.length > 1 ? (
          <div class="stn-grid">
            {quals.get(st.key)!.map((p) => <Section section={p.section} compact />)}
          </div>
        ) : null}

        {st.key === 'cases' && (
          <ul class="examples">
            {e.examples.map((x) => (
              <li>
                <span class="ex-d">{x.domain}</span>
                <span class="ex-t">{x.text}</span>
              </li>
            ))}
          </ul>
        )}

        {st.key === 'near' && (
          <Fragment>
            <ul class="cn-list">
              {e.concepts.map((c) => (
                <li>
                  {isLinked(c, lex.graph)
                    ? <a class="cn" href={href(`/?q=${encodeURIComponent(c)}`)}>{c}</a>
                    : <span class="cn">{c}</span>}
                </li>
              ))}
            </ul>
            {related.length > 0 && (
              <div class="rel">
                {related.map((r) => (
                  <a href={entryUrl(r.name)}>
                    <b><EntryName name={r.name} plain /></b>
                    <small>共用 {r.shared.map((t) => t.name).join('、')}</small>
                  </a>
                ))}
              </div>
            )}
          </Fragment>
        )}
      </section>
    ))}

    <footer class="entry-foot">
      <span>entries/{e.file}</span>
      <span class="entry-nav">
        {prev && <a href={entryUrl(prev)}>← {prev}</a>}
        {next && <a href={entryUrl(next)}>{next} →</a>}
      </span>
    </footer>
  </article>
</Base>
