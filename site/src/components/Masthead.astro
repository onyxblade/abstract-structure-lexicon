---
import { href, type Lexicon } from '../lib/lexicon';

interface Props {
  lex: Lexicon;
  view: 'entries' | 'build' | 'traits' | 'domains' | 'tensions';
}
const { lex, view } = Astro.props;
const { entries, examples, links } = lex.counts;
---
<header class="masthead">
  <div class="mast-in">
    <div>
      <p class="eyebrow">abstract structure lexicon</p>
      <h1><a href={href("/")}>抽象結構詞庫</a></h1>
      <p class="lede">可跨領域套用的結構。每個詞條有一句話定義、一組流程、跨領域的例子，以及它自己的張力。</p>
    </div>
    <div class="mast-side">
      <div class="theme" role="group" aria-label="配色">
        <button type="button" data-theme-set="system">系統</button>
        <button type="button" data-theme-set="light">淺</button>
        <button type="button" data-theme-set="dark">深</button>
      </div>
      <ul class="counts">
        <li><b>{entries}</b>詞條</li>
        <li><b>{examples}</b>例子</li>
        <li><b>{links}</b>概念連結</li>
      </ul>
    </div>
  </div>
  <div class="mast-in">
    <nav class="views">
      <a href={href("/")} aria-current={view === 'entries' ? 'page' : undefined}>詞條</a>
      <a href={href("/build/")} aria-current={view === 'build' ? 'page' : undefined}>組裝</a>
      <a href={href("/traits/")} aria-current={view === 'traits' ? 'page' : undefined}>特徵</a>
      <a href={href("/domains/")} aria-current={view === 'domains' ? 'page' : undefined}>領域</a>
      <a href={href("/tensions/")} aria-current={view === 'tensions' ? 'page' : undefined}>張力</a>
      <button type="button" class="rail-toggle" id="railToggle">目錄</button>
    </nav>
  </div>
</header>
